# AIQuantumOS environment
#
# Every variable here is optional. The application renders a complete
# Update Panel from the committed ingestion snapshot with none of them
# set, which is the intended experience for local development and for
# preview deployments.

# Public origin, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL="https://aiquantumos.com"

# ---------------------------------------------------------------------
# Database. Set this and the Update Panel reads live rows instead of the
# snapshot, and reports "Live index" in its status bar. Leave it unset
# and the snapshot is served, reported as such.
# ---------------------------------------------------------------------
# DATABASE_URL="postgresql://user:password@localhost:5432/aiquantumos"

# ---------------------------------------------------------------------
# Worker. Only read by the ingestion service, never by the web app.
# ---------------------------------------------------------------------
# Cron expression for the ingestion schedule, evaluated in UTC.
# Defaults to every three hours.
# INGEST_CRON="0 */3 * * *"

# Redis, for caching feed responses across worker and web instances.
# Optional; the application functions without it.
# REDIS_URL="redis://localhost:6379"
